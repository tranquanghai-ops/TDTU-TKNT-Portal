{
  "hosting": {
    "public": "build",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "apps-registry.json",
      "README.md",
      "node_modules/**",
      ".git/**",
      ".github/**"
    ],
    "cleanUrls": true,
    "trailingSlash": true,
    "redirects": [
      {
        "source": "/graduation/admin",
        "destination": "https://ifa-graduation.web.app/admin/",
        "type": 302
      },
      {
        "source": "/graduation/admin/:path*",
        "destination": "https://ifa-graduation.web.app/admin/:path*",
        "type": 302
      },
      {
        "source": "/graduation/supervisor",
        "destination": "https://ifa-graduation.web.app/supervisor/",
        "type": 302
      },
      {
        "source": "/graduation/supervisor/:path*",
        "destination": "https://ifa-graduation.web.app/supervisor/:path*",
        "type": 302
      },
      {
        "source": "/graduation/assessment",
        "destination": "https://ifa-graduation.web.app/assessment/",
        "type": 302
      },
      {
        "source": "/graduation/assessment/:path*",
        "destination": "https://ifa-graduation.web.app/assessment/:path*",
        "type": 302
      },
      {
        "source": "/graduation",
        "destination": "https://ifa-graduation.web.app/",
        "type": 302
      },
      {
        "source": "/graduation/:path*",
        "destination": "https://ifa-graduation.web.app/:path*",
        "type": 302
      }
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-store, max-age=0" }
        ]
      },
      {
        "source": "**/*.@(js|mjs|css|json)",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }
        ]
      },
      {
        "source": "**/*-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].@(js|css)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      }
    ]
  }
}
